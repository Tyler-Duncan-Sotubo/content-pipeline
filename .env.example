# Which model provider writes the articles: "openai" or "anthropic"
PROVIDER=openai

# OpenAI (used when PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Anthropic (used when PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Spotify (optional - enables direct Spotify track links; free at developer.spotify.com)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Your WordPress site (where articles get published)
WP_URL=https://your-site.com
WP_USER=your-wp-username
# Application Password: wp-admin -> Users -> Profile -> Application Passwords
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Optional: publish gospel posts (npm run pipeline:gospel) under a different WP
# user than WP_USER above. Leave both blank to use the same account for everything.
WP_USER_GOSPEL=
WP_APP_PASSWORD_GOSPEL=

# Optional: publish Ghana posts (npm run pipeline:ghana) under a different WP
# user than WP_USER above. Leave both blank to use the same account for everything.
WP_USER_GHANA=
WP_APP_PASSWORD_GHANA=

# Optional: publish Kenya posts (npm run pipeline:kenya) under a different WP
# user than WP_USER above. Leave both blank to use the same account for everything.
WP_USER_KENYA=
WP_APP_PASSWORD_KENYA=

# Entertainment / news aggregation - separate author so these posts
# are attributed distinctly from the music pipelines.
WP_USER_ENTERTAINMENT=
WP_APP_PASSWORD_ENTERTAINMENT=

# Which country's source site to pull from (see src/countries.ts). Currently: TZ
COUNTRY=TZ

# Overrides the country's default source site, if set
# SOURCE_URL=https://djmwanga.com

# "draft" until you trust the output, then "publish"
WP_POST_STATUS=draft

# Only consider source posts from the last N days (0 = no date limit)
LOOKBACK_DAYS=7

# Backfill only: exclude posts from the last N days so this run doesn't
# compete with production's live crons over the same recent posts (0 = no exclusion)
EXCLUDE_LAST_DAYS=0

# Max articles to generate per run
MAX_PER_RUN=3

# Freshness refresh (src/freshness/) - real "by {author} — {date}" byline
# refresh, not a fake timestamp bump. See freshness.service.ts for details.
# How often (in days) each post is eligible to be refreshed. No day-grouping -
# every overdue post is a candidate on every run, up to the per-run cap.
FRESHNESS_REFRESH_INTERVAL_DAYS=2.5
# Lowest post ID eligible for refresh. IMPORTANT: only lower this after
# verifying live that posts at your intended ID boundary are genuinely new
# content, not old posts caught in the Jan-Mar 2026 date-rewrite incident
# (see freshness.service.ts comment) - a date range is NOT a safe way to
# pick this value.
FRESHNESS_MIN_POST_ID=615731

# Logging - Better Stack (Logtail). Leave LOGTAIL_SOURCE_TOKEN/INGEST_HOST blank
# to log to console only (default local dev behavior).
LOG_LEVEL=debug
LOGTAIL_SOURCE_TOKEN=
LOGTAIL_INGEST_HOST=
LOGTAIL_LEVEL=warn
