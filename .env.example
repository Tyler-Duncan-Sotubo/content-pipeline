# Which model provider writes the articles: "openai" or "anthropic"
PROVIDER=openai

# OpenAI (used when PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Anthropic (used when PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Spotify (optional - enables direct Spotify track links; free at developer.spotify.com)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Your WordPress site (where articles get published)
WP_URL=https://your-site.com
WP_USER=your-wp-username
# Application Password: wp-admin -> Users -> Profile -> Application Passwords
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Optional: publish gospel posts (npm run pipeline:gospel) under a different WP
# user than WP_USER above. Leave both blank to use the same account for everything.
WP_USER_GOSPEL=
WP_APP_PASSWORD_GOSPEL=

# Optional: publish Ghana posts (npm run pipeline:ghana) under a different WP
# user than WP_USER above. Leave both blank to use the same account for everything.
WP_USER_GHANA=
WP_APP_PASSWORD_GHANA=

# Which country's source site to pull from (see src/countries.ts). Currently: TZ
COUNTRY=TZ

# Overrides the country's default source site, if set
# SOURCE_URL=https://djmwanga.com

# "draft" until you trust the output, then "publish"
WP_POST_STATUS=draft

# Only consider source posts from the last N days (0 = no date limit)
LOOKBACK_DAYS=7

# Max articles to generate per run
MAX_PER_RUN=3

# Logging - Better Stack (Logtail). Leave LOGTAIL_SOURCE_TOKEN/INGEST_HOST blank
# to log to console only (default local dev behavior).
LOG_LEVEL=debug
LOGTAIL_SOURCE_TOKEN=
LOGTAIL_INGEST_HOST=
LOGTAIL_LEVEL=warn
